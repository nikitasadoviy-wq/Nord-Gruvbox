[global]
    font = JetBrainsMono Nerd Font 10
    width = 320
    offset = 14x44
    origin = top-right
    frame_width = 2
    frame_color = "#81a1c1"
    separator_color = frame
    corner_radius = 6
    padding = 12
    horizontal_padding = 12

[urgency_low]
    background = "#282828"
    foreground = "#ebdbb2"
    timeout = 4

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#88c0d0"
    timeout = 6

[urgency_critical]
    background = "#282828"
    foreground = "#fb4934"
    frame_color = "#fb4934"
    timeout = 0
