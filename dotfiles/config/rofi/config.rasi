configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 11";
    display-drun: "󰀻 Apps";
    display-run: "󰆍 Run";
    display-window: "󱂬 Windows";
}

* {
    bg: #282828;
    bg-alt: #3c3836;
    fg: #ebdbb2;
    nord: #81a1c1;
    cyan: #88c0d0;
    background-color: @bg;
    text-color: @fg;
}

window {
    width: 520px;
    border: 2px;
    border-color: @nord;
    border-radius: 8px;
    padding: 16px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-alt;
    border-radius: 6px;
    padding: 8px 12px;
    margin: 0 0 12px 0;
}

prompt {
    text-color: @cyan;
    margin: 0 10px 0 0;
}

listview {
    lines: 8;
    columns: 1;
}

element {
    padding: 8px;
    border-radius: 6px;
}

element selected {
    background-color: @nord;
    text-color: @bg;
}
