#!/usr/bin/env bash

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d I II III IV V VI VII

bspc config border_width         2
bspc config window_gap          10
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Gruvbox Dark + Nord Blue borders
bspc config normal_border_color   "#3c3836"
bspc config active_border_color   "#5e81ac"
bspc config focused_border_color  "#81a1c1"
bspc config presel_feedback_color "#88c0d0"

# Автостарт компонентів, буфера обміну та скріншотера
pkill picom; picom --config ~/.config/picom/picom.conf &
pkill dunst; dunst &
pgrep -x greenclip > /dev/null || greenclip daemon &
pgrep -x flameshot > /dev/null || flameshot &
~/.config/polybar/launch.sh &
eww daemon &

# Фон робочого столу
xsetroot -solid "#282828"
